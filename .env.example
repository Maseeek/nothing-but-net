# Server Configuration
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/nbn

# JWT Secret (Change this to a secure random string in production)
JWT_SECRET=your-secret-key-here

# Email Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Frontend URL (used for CORS and email links)
# For development: http://localhost:5173
# For production: your actual frontend URL (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:5173

# Production Frontend URL (optional, for additional CORS origins)
# Leave empty if not needed, or set to your production frontend URL
# Example: PRODUCTION_FRONTEND_URL=https://yourdomain.com
PRODUCTION_FRONTEND_URL=
