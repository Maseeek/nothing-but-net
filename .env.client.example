# Client-side Environment Variables
# These must be prefixed with VITE_ to be accessible in the Vite app

# API Base URL (Backend server)
# For development: http://localhost:3000
# For production: your actual backend URL
VITE_API_BASE_URL=http://localhost:3000

# Analysis API URL (Video processing server)
# For development: http://localhost:5000
# For production: your actual analysis server URL
VITE_ANALYSIS_API_URL=http://localhost:5000
